# Contact-form email, sent via Resend (https://resend.com).
# Create a key at resend.com/api-keys.
RESEND_API_KEY=

# Sender address. The domain must be verified in Resend, otherwise sends fail.
# e.g. "Big Bearded Dev <hello@bigbearded.dev>"
FROM_EMAIL=

# Optional. Where submissions are delivered; defaults to mike@bigbearded.dev.
CONTACT_TO_EMAIL=
